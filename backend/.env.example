# Copy to .env (git-ignored) and fill in. Values: Supabase dashboard → Connect / Project Settings.
# Use the Session pooler connection (IPv4); the direct connection is IPv6-only.
DB_URL=jdbc:postgresql://aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
SUPABASE_URL=https://<project-ref>.supabase.co
CORS_ALLOWED_ORIGINS=http://localhost:3000
